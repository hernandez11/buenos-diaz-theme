<section class="bd-404">
  <div class="bd-404__digits-box">
    <p class="bd-404__digits">404</p>
    <div class="bd-404__window">
      <img
        class="bd-404__image"
        src="{{ 'Error_img.webp' | asset_url }}"
        alt=""
        width="2400"
        height="1800"
        decoding="async"
      >
    </div>
  </div>

  <a class="bd-404__message" href="{{ routes.root_url }}">
    <span class="bd-404__word">PAGE</span>
    <span class="bd-404__divider"></span>
    <span class="bd-404__word">NOT</span>
    <span class="bd-404__divider"></span>
    <span class="bd-404__word">FOUND</span>
  </a>
</section>

{% stylesheet %}
  .bd-404 {
    flex: 1;
    container-type: inline-size;
    background-color: var(--color-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6cqw, 5.5rem);
    padding: clamp(3rem, 8cqw, 7rem) clamp(1.5rem, 4cqw, 4rem);
  }

  .bd-404__digits-box {
    position: relative;
    width: min(100%, 1082px);
    aspect-ratio: 1082 / 292;
  }

  .bd-404__digits {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
    font-size: clamp(96px, 46.2cqw, 500px);
  }

  .bd-404__window {
    position: absolute;
    z-index: 1;
    left: 55.36%;
    top: -10.62%;
    width: 18.58%;
    height: 88.7%;
    overflow: hidden;
    border: 0.5px solid var(--color-white);
  }

  .bd-404__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.9);
    transform-origin: 100% 80%;
  }

  .bd-404__message {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2cqw, 1.5rem);
    width: 100%;
    text-decoration: none;
  }

  .bd-404__word {
    font-family: var(--font-sans);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    font-size: 1em;
    white-space: nowrap;
  }

  .bd-404__divider {
    display: block;
    width: clamp(60px, 12.73cqw, 220px);
    height: 1px;
    background-color: var(--color-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}

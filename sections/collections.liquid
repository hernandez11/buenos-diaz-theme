<section class="bd-shop">
  <div class="bd-shop__head">
    <span class="bd-shop__eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="bd-shop__heading">{{ section.settings.heading }}</h1>
  </div>

  <div class="bd-shop__grid">
    {% for collection in collections %}
      <a class="bd-shop__card" href="{{ collection.url }}">
        <div class="reveal-mask" data-reveal-index="{{ forloop.index0 | modulo: 3 }}" data-reveal-duration="0.9">
          <div class="reveal-inner">
            <div class="bd-shop__frame">
              {% if collection.featured_image %}
                <img
                  class="bd-shop__image"
                  src="{{ collection.featured_image | image_url: width: 900 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  width="900"
                  height="1125"
                  loading="lazy"
                  decoding="async"
                >
              {% endif %}
            </div>

            <div class="bd-shop__meta">
              <h3 class="bd-shop__name">{{ collection.title }}</h3>
              <span class="bd-shop__price">{{ collection.products_count }}</span>
            </div>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}

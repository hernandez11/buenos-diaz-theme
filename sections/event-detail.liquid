{%- liquid
  assign event = metaobject
  assign gallery = event.gallery.value

  assign layout_raw = event.layout.value | join: ','
  if layout_raw == blank
    assign layout_raw = 'full,pair,wide,tall'
  endif
  assign layout = layout_raw | split: ','

  assign pid = ''
  if event.poster.value.id != blank
    assign pid = event.poster.value.id
  elsif event.poster.id != blank
    assign pid = event.poster.id
  endif

  assign media_count = 0
  assign total_media = 0
  for f in gallery
    assign total_media = total_media | plus: 1
    if pid != blank and f.id == pid
      continue
    endif
    assign media_count = media_count | plus: 1
  endfor

  assign skip_poster = true
  if media_count == 0
    assign media_count = total_media
    assign skip_poster = false
  endif

  assign kinds = ''
  assign cursor = 0
  assign step = 0
  for i in (1..80)
    if cursor >= media_count
      break
    endif
    assign pi = step | modulo: layout.size
    assign kind = layout[pi] | strip
    assign remaining = media_count | minus: cursor
    assign span = 1
    if kind == 'pair'
      assign span = 2
    endif
    if span > remaining
      assign kind = 'full'
      assign span = 1
    endif
    if span == 2
      assign kinds = kinds | append: 'pairA,pairB,'
    else
      assign kinds = kinds | append: kind | append: ','
    endif
    assign cursor = cursor | plus: span
    assign step = step | plus: 1
  endfor
  assign kinds = kinds | split: ','
-%}

{% if event.description.value != blank %}
  <div class="bd-detail__overlay">
    <div class="reveal-mask" data-reveal-delay="0.16" data-reveal-duration="0.9">
      <div class="reveal-inner">
        <p class="bd-detail__description">{{ event.description.value }}</p>
      </div>
    </div>
  </div>
{% endif %}

<div class="bd-detail__meta">
  <span class="bd-detail__date">{{ event.date.value | date: '%m.%d' }}</span>
  <h1 class="bd-detail__title">{{ event.title.value }}</h1>
</div>

<div class="bd-detail__hero">
  {% render 'event-poster',
    field: event.poster,
    class: 'bd-detail__hero-image',
    alt: event.title.value,
    width: 1600
  %}
</div>

<div class="bd-detail">
  <div class="bd-detail__stack">
    {%- assign gi = 0 -%}
    {% for file in gallery %}
      {%- if skip_poster and pid != blank and file.id == pid -%}
        {% continue %}
      {%- endif -%}
      {%- liquid
        assign k = kinds[gi]
        assign gi = gi | plus: 1
        case k
          when 'wide'
            assign aspect = '746 / 334'
          when 'tall'
            assign aspect = '746 / 560'
          when 'pairA'
            assign aspect = '351 / 278'
          when 'pairB'
            assign aspect = '351 / 278'
          else
            assign aspect = '746 / 494'
        endcase
      -%}

      {%- if k == 'pairA' -%}
        <div class="bd-detail__column">
          <div class="bd-detail__pair">
      {%- elsif k != 'pairB' -%}
        <div class="bd-detail__column">
      {%- endif -%}

      <div class="bd-detail__frame" data-bd-frame style="aspect-ratio: {{ aspect }}">
        {% render 'event-media', file: file %}
      </div>

      {%- if k == 'pairB' -%}
          </div>
        </div>
      {%- elsif k != 'pairA' -%}
        </div>
      {%- endif -%}
    {% endfor %}
  </div>

  <div class="bd-detail__nav-row" aria-hidden="true">
    <div class="bd-detail__back-slot">
      <div class="reveal-mask" data-reveal-duration="0.9">
        <div class="reveal-inner">
          <a class="bd-detail__back bd-detail__back--mobile" href="/pages/events">Back To Events</a>
        </div>
      </div>
    </div>
  </div>
</div>

<nav class="bd-detail__sticky">
  <a class="bd-detail__back" href="/pages/events">Back To Events</a>
</nav>

{% stylesheet %}
  .bd-detail__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    container-type: inline-size;
    height: calc(clamp(220px, 14cqw, 280px) / 2);
    display: flex;
    align-items: flex-start;
    padding: 2vw 9.9cqw 0 25cqw;
    box-sizing: border-box;
    pointer-events: none;
    opacity: 1;
    animation: bd-detail-fade 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.15s backwards;
  }

  @keyframes bd-detail-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .bd-detail__description {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(11px, 0.868cqw, 15px);
    line-height: 1.4;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    text-align: left;
    max-width: 33.33vw;
    margin: 0;
  }

  .bd-detail__meta {
    position: fixed;
    left: 9.9vw;
    top: calc(var(--header-h, 88px) + 2vw);
    width: 13vw;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 0.3vw;
    pointer-events: none;
    opacity: 1;
    animation: bd-detail-fade 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.15s backwards;
  }

  .bd-detail__date {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(11px, 0.868cqw, 15px);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .bd-detail__title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8em;
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0;
    text-transform: uppercase;
  }

  .bd-detail__hero {
    position: relative;
    width: 50cqw;
    height: min(clamp(400px, 63.4cqw, 570px), 66svh);
    margin: calc(clamp(220px, 14cqw, 280px) / 2) auto 0;
    overflow: hidden;
    border: 0.5px solid var(--color-white);
  }

  .bd-detail__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bd-detail {
    width: 100%;
    background-color: var(--color-cream);
    container-type: inline-size;
    opacity: 1;
    animation: bd-detail-fade 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.15s backwards;
  }

  .bd-detail__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3cqw;
    padding-top: 3cqw;
  }

  .bd-detail__column {
    position: relative;
    width: 50cqw;
  }

  .bd-detail__pair {
    display: flex;
    gap: 2.5cqw;
    width: 100%;
  }

  .bd-detail__frame {
    width: 100%;
    overflow: hidden;
    flex: 1 1 auto;
    min-width: 0;
    clip-path: inset(100% 0 0);
    will-change: clip-path;
    transition: clip-path 1.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .bd-detail__frame.is-visible {
    clip-path: inset(0);
  }

  .bd-detail__photo,
  .bd-detail__clip {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bd-detail__clip {
    pointer-events: none;
  }

  .bd-detail__nav-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    visibility: hidden;
    pointer-events: none;
    padding: 7.6cqw 9.9cqw 7cqw;
  }

  .bd-detail__sticky {
    position: fixed;
    right: 9.9vw;
    bottom: calc(var(--footer-h, 56px) + 2vw);
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5vw;
    opacity: 1;
    animation: bd-detail-fade 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.15s backwards;
  }

  .bd-detail__back {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8em;
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  .bd-detail__back:hover {
    opacity: 0.6;
  }

  .bd-detail__back-slot {
    display: none;
  }

  @media (max-width: 767px) {
    .bd-detail__overlay {
      position: static;
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem 6% 0;
      pointer-events: auto;
      order: 2;
    }

    .bd-detail__description {
      max-width: none;
    }

    .bd-detail__meta {
      position: static;
      transform: none;
      width: auto;
      gap: 0.4rem;
      padding: 8rem 6% 0;
      pointer-events: auto;
    }

    .bd-detail__hero {
      width: 88%;
      height: auto;
      aspect-ratio: 4 / 5;
      margin: 1.5rem auto 0;
    }

    .bd-detail__stack {
      gap: 1.5rem;
      padding-top: 1.5rem;
    }

    .bd-detail__column {
      width: 88%;
    }

    .bd-detail__nav-row {
      padding: 3rem 6% 7rem;
    }

    .bd-detail__sticky {
      display: none;
    }

    .bd-detail__back-slot {
      display: block;
      align-self: flex-end;
      margin-left: auto;
      flex: 0 0 auto;
      min-width: max-content;
      visibility: visible;
      pointer-events: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Event detail",
  "settings": []
}
{% endschema %}

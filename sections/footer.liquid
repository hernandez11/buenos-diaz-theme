<footer class="bd-footer">
  <span class="bd-footer__text">{{ section.settings.tagline }}</span>

  <div class="bd-footer__social">
    {% if section.settings.instagram_url != blank %}
      <a
        class="bd-footer__link"
        href="{{ section.settings.instagram_url }}"
        target="_blank"
        rel="noreferrer"
      >
        {{ section.settings.instagram_label }}
      </a>
    {% endif %}
  </div>

  <span class="bd-footer__text bd-footer__text--end">{{ section.settings.copyright }}</span>
</footer>

{% stylesheet %}
  .bd-footer {
    position: relative;
    z-index: 2;
    width: 100%;
    box-sizing: border-box;
    container-type: inline-size;
    background-color: var(--color-cream);
    min-height: var(--footer-h, 56px);
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    gap: 2cqw;
    padding: 0.75cqw 4cqw;
  }

  .bd-footer__text {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(9px, 0.868cqw, 15px);
    letter-spacing: var(--tracking-tight);
    color: var(--color-black);
    white-space: nowrap;
    flex: 0 1 auto;
    min-width: 0;
  }

  .bd-footer__text--end {
    text-align: right;
  }

  .bd-footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9cqw;
    flex: 0 0 auto;
  }

  .bd-footer__link {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(9px, 0.868cqw, 15px);
    letter-spacing: var(--tracking-tight);
    color: var(--color-black);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .bd-footer__link:hover {
    opacity: 0.6;
  }

  @media (max-width: 767px) {
    .bd-footer {
      gap: 0.75rem;
      padding: 1rem;
    }

    .bd-footer__social {
      gap: 0.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Mobile Espresso Bar | NYC"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Instagram label",
      "default": "INSTAGRAM"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "@ Buenos Díaz Coffee, 2026"
    }
  ]
}
{% endschema %}

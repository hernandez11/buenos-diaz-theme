<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% render 'css-variables' %}

    {% render 'fonts' %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <div class="bd-shell">
      {% sections 'header-group' %}

      <main class="bd-main">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script type="module">
      import {
        initSmoothScroll,
        initReveals,
        initCursor,
        initVisualZoom,
        initHeader,
        initScrollLogo,
        initHero,
        initMenu,
        initContactForm,
        initContactScroll,
        initFaq,
      } from '{{ 'motion.js' | asset_url }}';

      const boot = () => {
        if (window.Lenis) initSmoothScroll(window.Lenis);
        initVisualZoom();
        initCursor();
        initHeader();
        initScrollLogo();
        initHero();
        initMenu();
        initContactScroll();
        initContactForm();
        initFaq();
        initReveals();
      };

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }

      document.addEventListener('shopify:section:load', () => initReveals());
    </script>
  </body>
</html>

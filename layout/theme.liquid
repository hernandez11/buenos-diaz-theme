{%- liquid
  assign bd_hidden = 'collection,product,list-collections,search,cart' | split: ','
  assign bd_template = request.page_type
  if bd_hidden contains bd_template
    assign bd_template = '404'
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% render 'css-variables' %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'shop.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    <script>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
    </script>
  </head>

  <body class="template-{{ bd_template }}">
    <div class="bd-shell">
      {% sections 'header-group' %}

      <main class="bd-main">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script type="module">
      import {
        initSmoothScroll,
        initReveals,
        initCursor,
        initVisualZoom,
        initHeader,
        initScrollLogo,
        initHero,
        initMenu,
        getLenis,
        initCountdown,
        initContactForm,
        initContactScroll,
        initFaq,
      } from '{{ 'motion.js' | asset_url }}';
      import {
        initEvents,
        initEventCards,
        initDetailFrames,
        initClips,
      } from '{{ 'events.js' | asset_url }}';

      const run = (name, fn) => {
        try {
          fn();
        } catch (error) {
          console.error('[buenos-diaz] ' + name + ' failed', error);
        }
      };

      const boot = () => {
        if (!window.location.hash) {
          window.scrollTo(0, 0);
        }
        run('reveals', () => initReveals());
        run('detailFrames', () => initDetailFrames());
        run('smoothScroll', () => {
          if (!window.Lenis) return;
          initSmoothScroll(window.Lenis);
          if (!window.location.hash) {
            const lenis = getLenis();
            if (lenis) lenis.scrollTo(0, { immediate: true });
          }
        });
        run('visualZoom', () => initVisualZoom());
        run('cursor', () => initCursor());
        run('header', () => initHeader());
        run('scrollLogo', () => initScrollLogo());
        run('hero', () => initHero());
        run('menu', () => initMenu());
        run('contactScroll', () => initContactScroll());
        run('contactForm', () => initContactForm());
        run('faq', () => initFaq());
        run('events', () => initEvents());
        run('eventCards', () => initEventCards());
        run('clips', () => initClips());
        run('countdown', () => initCountdown());
      };

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }

      document.addEventListener('shopify:section:load', () => run('reveals', () => initReveals()));
    </script>
  </body>
</html>

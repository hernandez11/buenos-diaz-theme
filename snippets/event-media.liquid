{%- liquid
  assign is_video = false
  if file.media_type == 'video' or file.sources
    assign is_video = true
  endif
-%}

{% if is_video %}
  {%- liquid
    assign small = blank
    assign large = blank
    assign any_mp4 = blank

    for source in file.sources
      assign su = source.url
      unless su contains '.mp4'
        continue
      endunless

      if any_mp4 == blank
        assign any_mp4 = source
      endif

      if su contains '480p'
        assign small = source
      endif

      if su contains '720p'
        assign large = source
      endif
    endfor

    if large == blank
      assign large = small
    endif

    if large == blank
      assign large = any_mp4
    endif

    if small == blank
      assign small = large
    endif
  -%}

  <video
    class="bd-detail__clip"
    muted
    loop
    playsinline
    preload="none"
    tabindex="-1"
    disablepictureinpicture
    controlslist="nodownload noplaybackrate noremoteplayback"
    aria-hidden="true"
    {% if file.preview_image %}
      poster="{{ file.preview_image | image_url: width: 1200 }}"
    {% endif %}
    data-bd-clip
  >
    {% if small != blank %}
      <source src="{{ small.url }}" type="video/mp4" media="(max-width: 767px)">
    {% endif %}
    {% if large != blank %}
      <source src="{{ large.url }}" type="video/mp4">
    {% endif %}
  </video>
{% else %}
  {%- assign photo = file.preview_image | default: file -%}
  <img
    class="bd-detail__photo"
    src="{{ photo | image_url: width: 800 }}"
    srcset="
      {{ photo | image_url: width: 400 }} 400w,
      {{ photo | image_url: width: 800 }} 800w,
      {{ photo | image_url: width: 1200 }} 1200w
    "
    sizes="(max-width: 767px) 88vw, 50vw"
    alt=""
    width="800"
    height="530"
    loading="lazy"
    decoding="async"
  >
{% endif %}
